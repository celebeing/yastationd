# Orion (Yandex Station 3) example configuration.
# Copy to /bkupgrade/cfw/yastationd.conf and replace the placeholder values before starting yastationd.
#
# A key this binary does not know is fatal (`load config err="…: unknown key"`), so check
# `yastationd -version` against the tree this file came from before replacing a live config.

# Unique MQTT/HA identity for this speaker. Use lowercase letters, digits, '_' or '-'.
device_id   = orion
device_name = Yandex Station 3

# --- MQTT broker / Home Assistant ---
# Leave mqtt_host empty for local-only operation. While the broker and the HA Wyoming link are not
# both up the ring pulses red (normal on a fresh unit; docs/status-indication.md, boot_connect_timeout).
mqtt_host = <mqtt-host>
mqtt_port = 1883
# mqtt_user = <mqtt-user>
# mqtt_pass = <mqtt-password>
topic_prefix     = yastation
discovery_prefix = homeassistant

# Pin the hardware profile during bring-up. "auto" is also supported after verification.
board = orion

# --- lights / 21x12 front display ---
tz                   = Europe/Moscow
ring_brightness      = 128
ambilight_brightness = 64
# LED frames streamed to the ambilight over DDP (LedFx, WLED tools; docs/ambilight-stream.md).
# The effects switch and brightness are runtime settings (HA, the web app). 0 = no receiver.
# ddp_port = 4048
# The music effects use the strip's white channel (off: drawn as R=G=B instead).
# ambilight_fx_white = true
# clock_brightness     = 255   (first start: the fixed level, and the brightest auto goes; later HA's Clock brightness)
# auto_brightness_min  = 0     (the dimmest auto goes; 0 = the board's matrix.min_brightness)
auto_brightness      = true
# Lux (calibrated: docs/sensor-calibration.md) -> front-display brightness, on log(lux).
# Default: 0.7:<board minimum>, 9:128, 150:255 (the minimum is the profile's matrix.min_brightness).
# auto_brightness_curve = 0.7:2, 9:128, 150:255
# Music on the screen (docs/music-sendspin.md): the title of a new track, pause/resume, and the
# spectrum under the clock while music plays.
# music_title  = true
# music_clips  = true
# music_levels = true

# --- physical controls / audio ---
# One step is one stock 5% level. The outer circular groove accumulates 20 steps per revolution.
volume_step = 1
# The loudest the speaker may go, in % of the board's stock curve (keys, the ring, HA, music).
# 100 % on every scale is then this level: the curve is applied first, its output scaled down.
# volume_max = 100
# Orion has no verified volume-tick asset yet.
volume_beep = false

# --- Wyoming satellite ---
# The stock «Алиса» model with its NPU verifier (verified on a unit); push-to-talk from the
# center glyph works either way.
wyoming_port = 10700
# the LED ring as a light entity in HA (its MQTT topic works either way)
# ha_ring_light = false
# LED preview stream for development (docs/led-preview.md); no auth, LAN only. Off when unset.
# frametap_addr = :8930
# Text on the screen: auto (one line if it fits, else two, else scrolling), 1 or 2 lines.
# text_lines = auto
# marquee_speed = 1   (running lines: 0.25..4 times the default pace)
# Room sound sensors for HA (Sound floor / level / activity: mic levels once a minute, never
# audio); they keep the mic open even with the wake word off.
# room_sound = true
# The web UI and API (docs/web-ui.md); "" = off. Login admin / yastation until changed from the
# app (it writes web_user and web_password here).
# http_addr = :80
# web_user = admin
# Speakers that hear one «Алиса» agree which answers: the loudest (docs/wake-arbitration.md).
# arbitration = true
# arbitration_wait_ms = 300
# Voice ID: who is talking, from the firmware's voiceprint model (docs/voice-id.md). One speaker
# keeps the voices (voice_store); "ignore guests" itself is an HA switch / web app option.
# voice_id              = false
# voice_store           = false
# voice_guest_threshold = 0.66
# voice_guest_margin    = 0.02
# voice_hold_ms         = 800
# voice_unsure          = allow
# voice_bio_dir         =
# This speaker's own sensor calibrations, over the board's (docs/sensor-calibration.md):
# lux_calibration = <reading>:<lux>, <reading>:<lux>
# mic_spl_offset  = <dB SPL - dBFS>
# Logs to a syslog server on the LAN (TCP), spooled on flash while it is unreachable
# (docs/storage.md). Off when unset.
# log_remote   = <syslog-host>:514
# log_spool_kb = 1024
# Reboot when the default gateway is unreachable this many minutes (doubling after each such
# reboot, up to 4 h); 0 = off.
# net_watchdog_min = 10
# Before that: reload wpa_supplicant's configuration, then reset the Wi-Fi controller, as the
# stock firmware does (minutes; 0 = that step off).
# net_wifi_recovery        = true
# net_wifi_reconfigure_min = 2
# net_wifi_reset_min       = 4
# net_wifi_reset_every_min = 10
# The "video" display mode's files (docs/video-mode.md; `make video VIDEO=<your file>`). Defaults:
# video_frames       = <cfw>/media/video.led   (video.led.gz is tried too)
# video_audio        = <cfw>/media/video.wav
# video_av_offset_ms = 0                       (positive = the picture later)
wake_enabled = true
# audio for HA starts preroll_ms before the point the wake word was heard (near its end);
# unset: the board's value (wake.preroll_ms, measured per model), else 300.
# wake_word_in_stream = true starts it 1.3 s earlier, with the wake word in it
# preroll_ms = 300
# wake_word_in_stream = false
# wake_capture: a test option, saves the audio around every wake word under <cfw>/wakes
# wake_capture = false

# --- clock / health ---
time_sync   = true
chrony_conf = /etc/chrony.conf
# Orion has no RTC, and the egress lock drops the vendor's ntp.yantp.net: name a time source that
# actually answers on your LAN (repeatable; tried before chrony_conf and the default gateway).
# ntp_server = <lan-ntp>
# Health probes: name=host:port@role, role broker|pipeline|lan. A failing probe turns the ring a
# dim red pulse and the state says degraded; the speaker keeps working. The placeholders below are
# not hostnames — point them at real hosts, or leave the probe lines out on a local-only unit.
# probe = broker=<mqtt-host>:1883@broker
# probe = hass=<ha-host>:8123@lan

# Use debug while validating the circular panel; change to info afterwards.
log_level = debug

# --- the rest, with their defaults (comments as in yastationd.conf.example; docs in brackets) ---
# Waiting for HA's reply: our deadline in s, and what a wake word does meanwhile
# (interrupt or ignore; docs/voice-slow-replies.md). First connection timeout at boot, in s
# (docs/status-indication.md).
# reply_timeout        = 90
# wake_while_waiting   = interrupt
# boot_connect_timeout = 40
# Asset packs in force, top first, one per line (docs/asset-packs.md; Assets → Packs sets it):
# theme = <pack id>
# theme_here = <pack id>         (this speaker's own theme in place of theme, never shared; Apply here)
# announce_chime = true         (a chime before an HA announcement; needs `make sounds`)
# Music Assistant player (docs/music-sendspin.md). Off by default.
# sendspin          = true
# sendspin_name     = <speaker name in HA>           (default: device_name)
# sendspin_server   = ws://<ma-host>:8927/sendspin   (optional: dial MA instead of waiting for it)
# sendspin_volume   = linked                         (linked or separate)
# music_duck_db     = -26                            (music level under the assistant, -60..0)
# sendspin_unpaired = true                           (let MA play before it is paired)
# sendspin_bin = <cfw>/bin/sendspin-host   sendspin_port = 8928   sendspin_state = <cfw>/sendspin/state.json
# Intercom (docs/intercom.md, docs/ha-intercom-setup.md). Off by default.
# intercom             = true
# intercom_secret      = <at least 16 characters, the same on every speaker>
# intercom_name        = <the room name others call this speaker by>   (default: device_name)
# intercom_port        = 10710   (UDP)
# intercom_auto_answer = false
# intercom_ring_secs   = 30
# intercom_max_secs    = 1800
# intercom_jitter_ms   = 40
# intercom_gain_db     = 30      (the uplink's gain only without the VQE call mode)
# vqe_models           =         (default <cfw>/vendor/vqe_models if there, else the firmware's)
# intercom_record_dir  =         (testing: save each call's raw uplink there)
# Wi-Fi setup mode (docs/wifi-setup.md): mute the mic, then hold the voice key for 5 s.
# wifi_setup         = true
# wifi_setup_ssid    = yastation-<device_id>
# wifi_setup_psk     =                (empty = open network; 8..63 characters = WPA2-PSK)
# wifi_setup_channel = 6
# wifi_setup_address = 10.42.0.1/24   (a /24)
# hostapd_bin        = <cfw>/bin/hostapd
# wpa_conf           =                (empty = the running wpa_supplicant's -c)
# Web app: web_password = (a pbkdf2-sha256$… hash, set from the app; empty = "yastation"),
# led_preview = true (the LED preview in the web app; docs/web-ui.md).
# Paths (defaults rooted under <cfw>; override only for testing):
# spotter_bin = <cfw>/bin/spotter-host   clips_dir = <cfw>/clips   scenarios_dir = <cfw>/scenarios
# state_file = <cfw>/yastationd.state   heartbeat_file = /tmp/yastationd.heartbeat   sysroot =
# lux_path =                    (the light sensor's IIO file; empty = found by the board profile)
# board_file = <cfw>/board.conf (single board-profile keys changed without a rebuild)
# Hardware overrides of the board profile, only when set here (orion's are verified; leave them):
# aplay_device, amixer_card, unmute, mic_device, mic_channels, mic_rate, mic_channel,
# mic_pdm_gain, spotter_libs, wake_model, command_model
