block2mtd: per-device MTD name and writesize, several devices when built in, configurable wait,
write-through.

  block2mtd.block2mtd=<dev>[,<erasesize>[,<name>[,<writesize>]]]   repeatable, registered in order
  block2mtd.timeout=<seconds>                                     wait per device (default 3)
  block2mtd.sync=<0|1>                                            write-through (default 1)

writesize lets UBI images made for 4 KiB-page NAND attach (UBI takes its min I/O unit from it); the
name keeps /proc/mtd identical to the real board; write-through makes a completed MTD write survive
an abrupt VM stop, like a programmed NAND page survives a power cut.

--- a/drivers/mtd/devices/block2mtd.c
+++ b/drivers/mtd/devices/block2mtd.c
@@ -31,6 +31,25 @@
 #include <linux/slab.h>
 #include <linux/major.h>
 
+/*
+ * Emulator extension: the device wait can be raised with block2mtd.timeout=<seconds> on the
+ * kernel command line (polled every 100 ms). Several block2mtd= parameters may be given to a
+ * built-in driver; they are registered in command-line order, so mtdN indices are stable.
+ */
+#define BLOCK2MTD_MAX_DEVS	16
+static unsigned int block2mtd_timeout = MTD_DEFAULT_TIMEOUT;
+module_param_named(timeout, block2mtd_timeout, uint, 0644);
+MODULE_PARM_DESC(timeout, "Seconds to wait for each block device to appear (built-in only)");
+
+/*
+ * Emulator extension: write erases and writes through to the block device before returning, so a
+ * completed MTD write survives an abrupt stop of the VM the way a programmed NAND page survives a
+ * power cut (otherwise it may sit in the guest page cache for up to dirty_expire).
+ */
+static bool block2mtd_sync_writes = true;
+module_param_named(sync, block2mtd_sync_writes, bool, 0644);
+MODULE_PARM_DESC(sync, "Write erases/writes through to the block device before returning (default 1)");
+
 /* Info for the block device */
 struct block2mtd_dev {
 	struct list_head list;
@@ -49,6 +68,14 @@
 	return read_mapping_page(mapping, index, NULL);
 }
 
+static int block2mtd_writeback(struct block2mtd_dev *dev, loff_t from, size_t len)
+{
+	if (!block2mtd_sync_writes || !len)
+		return 0;
+	return filemap_write_and_wait_range(dev->blkdev->bd_inode->i_mapping,
+					    from, from + len - 1);
+}
