# hostapd build configuration (copied to src/hostapd-*/hostapd/.config by the Makefile).
# Just an access point for the Wi-Fi setup mode: nl80211, open or WPA2-PSK, no RADIUS/EAP server.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL_TINY=y
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_NO_RADIUS=y
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_VLAN=y
CONFIG_NO_DUMP_STATE=y
CONFIG_CTRL_IFACE=y
