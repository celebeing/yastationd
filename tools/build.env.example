# Copy to tools/build.env (gitignored): local settings for tools/build.sh. tools/fetch-vendor.sh
# <ssh-target> <board> fills it in from your own speaker (and tools/deploy.sh runs that itself).
# spotter-host links the vendor libraries of the firmware your units run: a directory with lib/
# and system/vendor/quasar/libs/ per userland arch (docs/building.md, "The sysroot").
SPOTTER_SYSROOT_ARMHF=/path/to/vendor-repo/vendor/bergamot/<version_full>
SPOTTER_SYSROOT_AARCH64=/path/to/vendor-repo/vendor/pickle/<version_full>
