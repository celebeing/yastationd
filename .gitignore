# Raw device dumps: large and contain per-device secrets (wifi creds, tokens, TEE/keymaster material)
dumps/

# Secrets, wherever they appear
*.key
wpa_supplicant.conf

# Windows / WSL zone-identifier cruft
*:Zone.Identifier

# Local access/connection info (IPs, keys paths, recovery) — never commit
ACCESS.local.md
*.local.md

# Per-machine build settings (device address, ssh key)
local.mk

# Local build outputs (e.g. spotter-host cross-builds into build-*/)
build-*/

# Local Claude state that should never be committed
.claude/settings.local.json

# Python bytecode
__pycache__/
tools/deploy.hosts
spotter-host/build/

# Emulator work dir: kernel sources/builds, flash images made from dumps, seeds copied from units
emu/work/
.claude/worktrees/

# Artifacts from the pinned build container (tools/build-dist.sh)
/dist/

# The web app, built by make (tools/build-web.sh); embedded, not committed
/yastationd/internal/webui/dist/app/
/web/node_modules/
/.pnpm-store/
